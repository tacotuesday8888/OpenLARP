{
  "name": "@openlarp/ai-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "esbuild": "0.28.1",
    "typescript": "5.8.3",
    "vitest": "4.1.9"
  }
}
